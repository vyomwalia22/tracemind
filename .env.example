# Server-side The Graph Gateway API key. Never expose this as NEXT_PUBLIC_*
THE_GRAPH_API_KEY=

# Server-side Anthropic Claude credential for the AI investigation engine.
# Never expose either of these as NEXT_PUBLIC_*.
# Recommended: a direct Anthropic API key from the Anthropic Console.
ANTHROPIC_API_KEY=
# Optional alternative: a bearer token explicitly issued for this application
# (sent as a plain Authorization: Bearer header). This is NOT a shortcut for
# an interactive Claude Pro/Max or Claude Code login - those credentials are
# stored elsewhere and are never read by this application.
ANTHROPIC_AUTH_TOKEN=
